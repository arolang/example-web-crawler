(* ============================================================
   ARO Web Crawler - Link Pipeline (normalize → filter → queue)

   The HTML is parsed up-front by CrawlPage; this stage just fans
   the pre-extracted href list out into NormalizeUrl events.
   ============================================================ *)

(Extract Links: ExtractLinks Handler) {
    (* Typed event extraction - validates against ExtractLinksEvent schema *)
    Extract the <event-data: ExtractLinksEvent> from the <event>.

    (* Cap fan-out per page. Without this, a page with N links spawns N
       concurrent Tasks (FeatureSetExecutor.swift:870 defaults concurrency
       to items.count). For a site with hundreds of links per page and
       many pages crawling at once, that blew up Swift task overhead. *)
    parallel for each <raw-url> in <event-data: links> with <concurrency: 16> {
        Emit a <NormalizeUrl: event> with {
            raw: <raw-url>,
            base: <event-data: base>,
            depth: <event-data: depth>,
            max: <event-data: max>
        }.
    }

    Return an <OK: status> for the <extraction>.
}

(Normalize URL: NormalizeUrl Handler) {
    Extract the <raw-url> from the <event: raw>.
    Extract the <base-domain> from the <event: base>.
    (* Depth/limit ride through this stage untouched — the target inherits the
       depth already assigned when its parent extracted links. *)
    Extract the <depth> from the <event: depth>.
    Extract the <max-depth> from the <event: max>.

    match <raw-url> {
        case /^https?:\/\// {
            (* Already absolute *)
            Emit a <FilterUrl: event> with { url: <raw-url>, base: <base-domain>, depth: <depth>, max: <max-depth> }.
        }
        case /^\// {
            (* Root or root-relative: prepend origin (scheme+host) *)
            Split the <scheme-parts> from the <base-domain> by /:\/\//.
            Extract the <scheme: first> from the <scheme-parts>.
            Extract the <hostpath: last> from the <scheme-parts>.
            Split the <hostsegs> from the <hostpath> by /\//.
            Extract the <host: first> from the <hostsegs>.
            Create the <joined-url> with "${<scheme>}://${<host>}${<raw-url>}".
            Emit a <FilterUrl: event> with { url: <joined-url>, base: <base-domain>, depth: <depth>, max: <max-depth> }.
        }
        case /^(#|mailto:|javascript:|tel:|data:|\.)/ {
            (* Skip fragments, special schemes, and relative parent paths *)
        }
        case /[a-zA-Z]/ {
            (* Relative: resolve against base *)
            Create the <joined-url> with "${<base-domain>}/${<raw-url>}".
            Emit a <FilterUrl: event> with { url: <joined-url>, base: <base-domain>, depth: <depth>, max: <max-depth> }.
        }
    }

    Return an <OK: status> for the <normalization>.
}

(Filter URL: FilterUrl Handler) {
    Extract the <url> from the <event: url>.
    Extract the <base-domain> from the <event: base>.
    (* Depth/limit pass through unchanged; the queue stage records them. *)
    Extract the <depth> from the <event: depth>.
    Extract the <max-depth> from the <event: max>.

    (* Strip fragment and trailing slashes once, centrally *)
    Split the <frag-parts> from the <url> by /#/.
    Extract the <no-fragment: first> from the <frag-parts>.
    Split the <slash-parts> from the <no-fragment> by /\/+$/.
    Extract the <clean-url: first> from the <slash-parts>.

    (* Same-origin check: extract host from both clean-url and base-domain
       and compare. ARO's `contains` is list-membership (see MastoStream /
       FediTerm usage), not substring matching, so we can't just ask whether
       the URL string contains the base string. Split only accepts a regex
       literal, not a runtime separator, so we walk both sides identically. *)
    Split the <clean-scheme-parts> from the <clean-url> by /:\/\//.
    Extract the <clean-hostpath: last> from the <clean-scheme-parts>.
    Split the <clean-hostsegs> from the <clean-hostpath> by /\//.
    Extract the <clean-host: first> from the <clean-hostsegs>.

    Split the <base-scheme-parts> from the <base-domain> by /:\/\//.
    Extract the <base-hostpath: last> from the <base-scheme-parts>.
    Split the <base-hostsegs> from the <base-hostpath> by /\//.
    Extract the <base-host: first> from the <base-hostsegs>.

    (* Resolve max URL length: MAX_URL_LENGTH env var, fallback 0 (= unlimited).
       Set MAX_URL_LENGTH=0 (or leave it unset) to disable the length check. *)
    Extract the <max-len-str> from the <env: MAX_URL_LENGTH>.
    match <max-len-str> {
        case /^[0-9]+$/ {
            Transform the <max-length: int> from the <max-len-str>.
        }
        case /./ {
            Create the <max-length> with 0.
        }
        case /^$/ {
            Create the <max-length> with 0.
        }
    }
    Compute the <url-length: length> from the <clean-url>.

    (* Resolve URL stopword list: SKIP_WORDS_IN_URL=foo,bar,hausmeister.
       Token-based match: tokenize the URL on non-alphanumerics and intersect
       with the comma-split stopword list. This matches whole path segments
       and query-arg names (so "en" hits /en/ but not /engineering/). *)
    Extract the <skip-words-str> from the <env: SKIP_WORDS_IN_URL>.
    Split the <skip-words> from the <skip-words-str> by /,/.
    Split the <url-tokens> from the <clean-url> by /[^a-zA-Z0-9]+/.
    Compute the <matched-words: intersect> from <url-tokens> with <skip-words>.
    Compute the <matched-count: length> from the <matched-words>.
    (* Only crawl HTML pages - skip images, documents, media, fonts, archives, and other non-HTML resources *)
    match <clean-url> {
        case /\.(png|jpg|jpeg|gif|svg|webp|ico|bmp|tiff|pdf|doc|docx|xls|xlsx|ppt|pptx|zip|tar|gz|rar|7z|mp3|mp4|avi|mov|wmv|flv|webm|ogg|wav|woff|woff2|ttf|eot|otf|css|js|json|xml|rss|atom|yaml|yml|toml|csv|exe|dmg|pkg|deb|rpm|msi|bin|iso|apk|img|eps|tif)(\?.*)?$/ {
            Log "Skipping non-HTML: ${<clean-url>}" to the <console> when <env: DEBUG> == "1".
        }
        case /\/([^\/]+)\/\1\/\1(\/|$)/ {
            (* Same path segment repeated 3+ times in a row (e.g. /undefined/undefined/undefined/)
               indicates a broken link template or crawler trap — stop descending here. *)
            Log "Skipping repeated-segment URL: ${<clean-url>}" to the <console> when <env: DEBUG> == "1".
        }
        case /./ {
            (* Overlong URLs are usually a sign of session-encoded state or a crawler trap. *)
            Log "Skipping over-long URL: ${<clean-url>} _ ${<url-length>} - ${<max-length>}" to the <console> when <env: DEBUG> == "1" and <max-length> > 0 and <url-length> > <max-length>.
            Log "Skipping stopword URL: ${<clean-url>}" to the <console> when <env: DEBUG> == "1" and <matched-count> > 0.
            (* Two mutually-exclusive emits to side-step `or` inside `when` —
               an inline `or` in a `when` clause did not group with parens the
               way you'd expect, and silently killed every emit. *)
            Emit a <QueueUrl: event> with { url: <clean-url>, base: <base-domain>, depth: <depth>, max: <max-depth> }
                when <clean-host> == <base-host>
                and <max-length> == 0
                and <matched-count> == 0.
            Emit a <QueueUrl: event> with { url: <clean-url>, base: <base-domain>, depth: <depth>, max: <max-depth> }
                when <clean-host> == <base-host>
                and <max-length> > 0
                and <url-length> <= <max-length>
                and <matched-count> == 0.
        }
    }

    Return an <OK: status> for the <filter>.
}

(Queue URL: QueueUrl Handler) {
    (* Extract from event data structure *)
    Extract the <url> from the <event: url>.
    Extract the <base-domain> from the <event: base>.
    (* Depth of this URL (parent + 1) and the global limit, carried on so the
       drain loop can re-emit CrawlPage with them intact. Dedup is by URL hash,
       so a URL keeps the depth it was first discovered at — and the level-by-
       level drain means that is its shallowest reachable depth. *)
    Extract the <depth> from the <event: depth>.
    Extract the <max-depth> from the <event: max>.

    (* Generate deterministic id from URL hash for deduplication *)
    Compute the <url-id: hash> from the <url>.

    (* Store with id - repository deduplicates by id, observer only fires for new entries *)
    Create the <crawl-request> with { id: <url-id>, url: <url>, base: <base-domain>, depth: <depth>, max: <max-depth> }.
    Store the <crawl-request> into the <crawled-repository>.

    Return an <OK: status> for the <queue>.
}

(Queue Pending: crawled-repository Observer) {
    (* Mirror the new entry into pending-repository — do NOT emit
       CrawlPage here. The drain loop in main.aro picks it up at the
       top of the call stack. Emitting CrawlPage from this observer
       used to chain Observer → CrawlPage → ExtractLinks → ... →
       QueueUrl → Store → Observer → CrawlPage synchronously, pinning
       one task-pool slot per recursion level and deadlocking on any
       non-trivial site.

       ONLY mirror `created` changes. A store into crawled-repository fires
       `created` for a brand-new id but `updated` when an existing id is
       re-stored with a *different* value — and because each crawl-request
       carries the URL's `depth`, re-discovering a page at a deeper level
       writes a different record and would otherwise re-enqueue (and, with no
       depth limit, loop forever) a page already crawled. Gating on `created`
       is the structural dedup: a URL is queued exactly once, at the shallowest
       depth it is first reached (the drain is level-by-level / BFS). *)
    Extract the <crawl-request> from the <event: newValue>.

    Log "Queued: ${<crawl-request: url>}" to the <console> when <env: DEBUG> == "1" and <event: changeType> == "created".
    Store the <crawl-request> into the <pending-repository> when <event: changeType> == "created".

    Return an <OK: status> for the <observer>.
}
